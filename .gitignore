# BigBrother ignore rules

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual env
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
# Office lock files (e.g. ~$Doc.docx)
~$*

# Secrets — OAuth client config and user tokens (incl. accidental "copy" duplicates)
config/credentials*.json
config/client_secret*.json
config/token*.json
*.pem
*.key

# Personal overrides (camera, calendar_id, etc.) — create your own from local.yaml.example
config/local.yaml

# Data files — runtime state, not source code
data/stats.json
data/roast_history.json

# Model weights (auto-downloaded)
models/*.pt

# Sound files (large binaries)
# sounds/*.wav
